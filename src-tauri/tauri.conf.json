{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbox",
  "version": "1.0.0",
  "identifier": "com.toolbox.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "工具箱",
        "width": 1366,
        "height": 768,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
